# Supply keys locally; never commit this file as .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=3000
HOST=127.0.0.1
# Optional for npm start. Without this, history is temporary and lost on restart.
# Use the connection string supplied by your PostgreSQL host; TLS is supported via its URL options.
DATABASE_URL=
# Docker Compose configures DATABASE_URL automatically and keeps PostgreSQL off host ports.
# This sample password is for the isolated local demo only. Replace before deployment.
# If changed, use a URL-safe password (letters, digits, underscores or hyphens).
POSTGRES_PASSWORD=voice_router_local_only
